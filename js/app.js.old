        duration: 5000,
        progress: true,
        closeOnTimeup: true,
        onTick: (remainingSeconds, modal) => {

        },
        onTimeup: async (modal) => {
            // Do something when timer ends
            // console.log('onTimeup')
            // console.log(modal)
        }
    }
    }).show()
};



